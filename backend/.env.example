PORT=5000
FLASK_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=weights/pneumonia_model.tflite

# Minimum sigmoid score (0-1) required to classify as Pneumonia.
# 0.65 = require 65% confidence before flagging as Pneumonia (reduces false positives).
# Lower to 0.50 if you have a properly trained model on the full Kaggle dataset.
PNEUMONIA_THRESHOLD=0.65
